	)
	(text "To obtain best efficency always use converter that uses most of the advised by producer current range. \nFor MP432XX fammily there are following possibilites:\nMP4320 - 0.5A (Requires bigger coil L = 5.6uH, lower freq = 1.8Mhz)\nMP4321 - 1A (Requires bigger coil L = 5.6uH)\nMP4322 - 2A (current implemenation)\nMP4323 - 3A (same as 2A)\nCaution changing output voltage requires changes of FB shunt resistor!"
		(exclude_from_sim no)
		(at 69.088 150.114 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left)
		)
		(uuid "b1d9ed39-5647-4216-a8af-5a460e9c940f")
